# FG-Analyzer local/runtime files
# Keep source, tests, deployment scripts, documentation, web assets and Go modules public.

# Environment and secrets
.env
.env.*
!.env.example
*.secret
*.secrets
secrets/

# Runtime configuration (may contain DB/SNMP/auth credentials)
config.json
config.local.json
config.*.local.json

# Certificates and private keys
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
certs/
private/

# Local databases and runtime data
*.db
*.db-*
*.sqlite
*.sqlite3
data/
runtime/

# Logs, reports and exports produced locally
*.log
logs/
reports/
exports/
*.csv

# Backups / temporary files
*.bak
*.backup
*.tmp
*.temp
*.swp
*~
backup/
backups/

# Build outputs / binaries
*.exe
*.dll
*.so
*.dylib
*.out
*.test
bin/
build/
dist/
release/

# Go tooling / profiling / coverage
coverage.out
coverage.html
*.coverprofile
*.prof
cpu.prof
mem.prof

# IDE / editor metadata
.vscode/
.idea/
*.code-workspace

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Local archives/package artifacts
*.zip
*.7z
*.tar
*.tar.gz
*.tgz

# Local scratch directories
cache/
tmp/
temp/
